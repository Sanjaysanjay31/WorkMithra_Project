# Copy to .env and fill in real values. Never commit .env.
#
# EXPO_PUBLIC_API_URL is the only frontend env var. Expo inlines EXPO_PUBLIC_*
# from this file at build time (app.json does NOT supply it). If unset, the
# app falls back to a local dev URL: http://10.0.2.2:8000 on Android
# emulators, http://127.0.0.1:8000 elsewhere.
#EXPO_PUBLIC_API_URL=https://workmithra.onrender.com
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000

# Supabase (frontend — needed for image storage, auth OTP)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here