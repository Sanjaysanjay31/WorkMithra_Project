# Copy to backend/.env and fill in real values. Never commit backend/.env.
#
# JWT_SECRET — REQUIRED. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Without it the server refuses to start.
JWT_SECRET=change-me-to-a-random-secret

# DATABASE_URL — PostgreSQL connection string (Supabase pooler format)
DATABASE_URL=postgresql://postgres.your-project@aws-1-ap-south-1.pooler.supabase.com:6543/postgres

# Supabase (backend — for OTP auth + image storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key-here
SUPABASE_BUCKET_NAME=all_images

# AI provider keys — multilingual fallback system (keys stay server-side;
# the frontend only ever talks to this backend's /ai/* endpoints).
#
#   STT chain: Sarvam -> Gemini -> Groq Whisper   (Sarvam preferred for Telugu & Indian languages)
#   LLM chain: Gemini -> Groq -> Sarvam           (Gemini is the default LLM)
#   TTS chain: Sarvam -> Gemini                   (Sarvam preferred for Indian voices)
#
# A missing key simply skips that provider in the chain.
SARVAM_API_KEY=your-sarvam-api-key
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key

# Model names (defaults shown — verified against provider docs Aug 2026).
# STT
SARVAM_STT_MODEL=saaras:v3
GEMINI_STT_MODEL=gemini-3.5-transcribe
GROQ_STT_MODEL=whisper-large-v3-turbo
# LLM
# NOTE: gemini-3.7-flash was verified (Aug 2026) to hang on chat completions
# (>150s, both API endpoints). gemini-3.6-flash responds in a few seconds and
# is used instead. gemini-2.5-flash is retired; gemini-3.5-flash returns empty.
GEMINI_LLM_MODEL=gemini-3.6-flash
GROQ_LLM_MODEL=openai/gpt-oss-20b
SARVAM_LLM_MODEL=sarvam-105b-conversations
# TTS
SARVAM_TTS_MODEL=bulbul:v3
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
# Optional voice overrides
SARVAM_TTS_SPEAKER=ishita
GEMINI_TTS_VOICE=Kore

# Legacy last-resort LLM (only used if the whole Gemini->Groq->Sarvam chain
# fails). Safe to leave unset.
HF_TOKEN=your-huggingface-token
MODEL_NAME=meta-llama/Llama-3.1-8B-Instruct
# Deprecated alias for SARVAM_LLM_MODEL (kept for older deployments)
SARVAM_CHAT_MODEL=sarvam-105b-conversations

# Email OTP is delivered entirely via Supabase Auth — no SendGrid/SMTP
# credentials are used or needed anywhere in this backend.

# Rate limiting — set to 0 to disable for tests
RATE_LIMITING=1

# Razorpay (TEST MODE) — in-app payments. Get test keys from the Razorpay
# dashboard: Settings -> API Keys -> Generate test key. The key id is public
# (returned to the app by /payments/order); the SECRET must stay server-side.
# Leaving these unset disables payments cleanly (503 on /payments/*).
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-test-key-secret

# CORS origins — comma-separated. Wildcard is dev-only fallback.
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8082,http://localhost:19006,https://workmithra.onrender.com

# Socket.IO origins (SEPARATE from ALLOWED_ORIGINS above — the REST CORS list
# does not apply to sockets). Native apps use exp:// / LAN origins that can't
# be enumerated, so unset means '*' (safe: socket auth is JWT, not cookies).
#SOCKET_CORS_ORIGINS=https://workmithra.onrender.com