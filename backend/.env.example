# Copy to backend/.env and fill in real values. Never commit backend/.env.
#
# JWT_SECRET — REQUIRED. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Without it the server refuses to start.
JWT_SECRET=change-me-to-a-random-secret

# DATABASE_URL — PostgreSQL connection string (Supabase pooler format)
DATABASE_URL=postgresql://postgres.your-project@aws-1-ap-south-1.pooler.supabase.com:6543/postgres

# Supabase (backend — for OTP auth + image storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key-here
SUPABASE_BUCKET_NAME=all_images

# AI keys — Sarvam AI (STT/TTS/Translate) + HuggingFace (Llama chat)
SARVAM_API_KEY=your-sarvam-api-key
HF_TOKEN=your-huggingface-token
MODEL_NAME=meta-llama/Llama-3.1-8B-Instruct
SARVAM_CHAT_MODEL=sarvam-105b-conversations

# Email (for OTP delivery via Supabase Auth)
# SENDGRID_API_KEY=your-sendgrid-key
# SENDER_EMAIL=your-email@example.com

# Rate limiting — set to 0 to disable for tests
RATE_LIMITING=1

# CORS origins — comma-separated. Wildcard is dev-only fallback.
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8082,http://localhost:19006,https://workmithra.onrender.com